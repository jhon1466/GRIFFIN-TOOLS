{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Griffin GM Tools",
  "version": "0.1.0",
  "identifier": "com.griffin.gmtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Griffin GM Tools",
        "width": 1500,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
